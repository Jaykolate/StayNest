<% layout('layouts/boilerplate') -%>

<main class="d-flex justify-content-center align-items-center text-center" style="min-height: 80vh;">
  <div class="alert alert-danger shadow-lg p-5 rounded-4 col-md-6">
    <div class="mb-3">
      <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
    </div>
    <h2 class="fw-bold mb-3"><%= message %></h2>
    <p class="lead">Error Code: <strong><%= statusCode %></strong></p>
    <a href="/listings" class="btn btn-dark mt-3 px-4 py-2 rounded-pill">
      <i class="bi bi-house-door"></i> Go Back Home
    </a>
  </div>
</main>

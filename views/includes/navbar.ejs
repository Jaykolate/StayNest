<style>
   .btn-search{
    background-color: #8d1198;
    color:#fff;
    border-radius: 25px;
    padding:0 1rem 0 1rem;
   }
   .btn-search:hover{
    background-color: #8d1198;
    color:#fff;
   }
   .btn-search i{
    display:inline;
    margin-right: 0.5rem;
   }
   @media (max-width: 768px) {
  .navbar-nav {
    text-align: center;
  }

  .navbar form {
    width: 100%;
    margin: 0.5rem 0;
  }

  .navbar form input,
  .navbar form button {
    width: 100%;
    margin: 0.3rem 0;
  }

  .navbar form button i {
    display: none; /* hide icon on small screens */
  }
}
@media (max-width: 768px) {

  .navbar-collapse {
    padding: 1rem 0;
  }

  .navbar-nav {
    gap: 0.5rem;
  }

  .btn-search {
    width: 100%;
    padding: 0.6rem;
  }

  .navbar-nav a {
    font-size: 1rem;
  }

}

</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        
        <a class="nav-link" href="/listings">Explore</a>
       
        
      </div>
      <div class="navbar-nav mx-md-auto my-2 my-md-0">
        <form class="d-flex flex-column flex-md-row" role="search" action="/listings" method="GET">
    <input class="form-control mb-2 mb-md-0 me-md-2" name="search" type="search" placeholder="Search Destination" value="<%= search %>" >
    <button class="btn btn-search" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
  </form>
      </div>
      <div class="navbar-nav ms-md-auto text-center" >
         <a class="nav-link" href="/listings/new">StayNest Your Home</a>
        <% if(!currUser) { %>
        <a class="nav-link"  href="/signup"> <b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Login</b></a>
        <% } %>
         <% if(currUser) { %>
        <a class="nav-link" href="/logout"><b>Logout</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>